{
  "name": "trustbridge-action",
  "version": "1.0.0",
  "description": "GitHub Action to verify Stellar account trustlines and XLM reserve before issue assignment workflows",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc --noEmit && ncc build src/index.ts -o dist --source-map --license licenses.txt && node scripts/normalize-maps.js",
    "bundle-size": "npm test -- --testPathPattern bundle-size --no-coverage",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:mock": "jest --testPathPattern horizon-mock-smoke --forceExit",
    "lint": "eslint src __tests__ --ext .ts",
    "prepare": "npm run build",
    "mock:start": "docker compose -f mock/horizon/docker-compose.yml up -d --wait",
    "mock:stop": "docker compose -f mock/horizon/docker-compose.yml down",
    "mutation": "stryker run",
    "mutation:ci": "stryker run --reporters clear-text,progress"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Stellar-TrustBridge/trustbridge-action.git"
  },
  "keywords": [
    "github-action",
    "stellar",
    "trustline",
    "horizon",
    "usdc"
  ],
  "author": "Stellar-TrustBridge",
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/github": "^6.0.1",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^10.0.0",
    "@stryker-mutator/jest-runner": "^10.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/node-fetch": "^2.6.12",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "license-checker": "^25.0.1",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
